# ============================================================
# NovaAI Environment Configuration
# Copy to .env and fill in your values
# ============================================================

# ── Application ──
APP_NAME=NovaAI
APP_VERSION=1.0.0
DEBUG=false

# ── Groq LLM ──
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.7
GROQ_MAX_TOKENS=1024

# ── Database ──
DATABASE_URL=sqlite+aiosqlite:///./data/ai_assistant.db

# ── JWT Authentication ──
JWT_SECRET_KEY=change-this-to-a-random-64-char-string-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ──
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# ── Redis ──
REDIS_URL=redis://localhost:6379/0
REDIS_USE_FAKE=true
REDIS_SESSION_TTL=3600
REDIS_CACHE_TTL=86400
REDIS_MAX_RECENT_MESSAGES=20

# ── ChromaDB ──
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION=memories
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ── Memory ──
MEMORY_ENABLED=true
MEMORY_SIMILARITY_THRESHOLD=0.6
MEMORY_MAX_RESULTS=10
MEMORY_IMPORTANCE_THRESHOLD=0.7

# ── Voice (STT) ──
WHISPER_MODEL=tiny
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=en
WHISPER_BEAM_SIZE=5

# ── Voice (TTS) ──
TTS_VOICE=en-US-GuyNeural
TTS_RATE=+0%
TTS_VOLUME=+0%

# ── Voice (General) ──
VOICE_ENABLED=true
MAX_AUDIO_SIZE_MB=25
MAX_AUDIO_DURATION_SEC=120

# ── RAG ──
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=200
RAG_MAX_FILE_SIZE_MB=20
RAG_DEFAULT_RESULTS=5
RAG_COLLECTION=documents

# ── MCP (Model Context Protocol) ──
# Supports multiple servers; JSON array of {name, command, args}
MCP_SERVERS=[{"name":"github","command":"npx","args":["-y","@modelcontextprotocol/server-github"]}]
MCP_AUTO_CONNECT=true

# ── Rate Limiting ──
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# ── Security ──
ALLOWED_HOSTS=["*"]
MAX_REQUEST_SIZE_MB=50
